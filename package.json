{
  "name": "pc-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Australian PC deal finder",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "tsx scrapers/run.ts",
    "scrape:dry": "tsx scrapers/run.ts --dry-run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "^5.12.0",
    "postgres": "^4.0.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
