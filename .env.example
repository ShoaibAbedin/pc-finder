# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# Supabase → Project Settings → API (or "Connect" button)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET: full database access. Server/scraper use only — never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string (IPv4-friendly). Used only by `npm run db:migrate`.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Private-site lock: open https://<your-site>/unlock?key=<SITE_KEY> once per device. Generate a long random value.
SITE_KEY=

# AI (both free tiers). Gemini is the main model, Groq the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_DAILY_LIMIT=200
# GROQ_DAILY_LIMIT=800
# AI_MAX_BATCHES_PER_RUN=60
